<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>1 BHK House for Rent</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    color: #222;
    line-height: 1.6;
}

.container {
    width: 92%;
    max-width: 900px;
    margin: auto;
}

/* HEADER */

.header {
    background: #111;
    color: white;
    text-align: center;
    padding: 35px 20px;
}

.header h1 {
    font-size: 32px;
    margin-bottom: 8px;
}

.header p {
    font-size: 17px;
    color: #ddd;
}

/* IMAGES */

.property-image {
    width: 100%;
    display: block;
    margin: 25px auto;
    border-radius: 15px;
    max-height: 600px;
    object-fit: cover;
}

/* CARDS */

.card {
    background: white;
    padding: 25px;
    margin: 25px 0;
    border-radius: 15px;
    box-shadow: 0 3px 15px rgba(0,0,0,0.08);
}

.card h2 {
    margin-bottom: 15px;
    font-size: 25px;
}

/* PRICE */

.price {
    background: #111;
    color: white;
    text-align: center;
    padding: 25px;
    margin: 25px 0;
    border-radius: 15px;
}

.price h2 {
    font-size: 32px;
    margin: 5px 0;
}

.price p {
    color: #ddd;
}

/* DETAILS */

.details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.detail {
    background: #f3f3f3;
    padding: 15px;
    border-radius: 10px;
}

.detail strong {
    display: block;
}

/* AMENITIES */

.amenities {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.amenity {
    background: #f3f3f3;
    padding: 13px;
    border-radius: 9px;
}

/* CONTACT */

.contact {
    background: #111;
    color: white;
    text-align: center;
    padding: 35px 20px;
    margin-top: 30px;
}

.contact h2 {
    margin-bottom: 10px;
}

.phone {
    font-size: 20px;
    margin-top: 15px;
}

.whatsapp {
    display: inline-block;
    margin-top: 20px;
    padding: 14px 28px;
    background: #25D366;
    color: white;
    text-decoration: none;
    border-radius: 30px;
    font-weight: bold;
}

/* FOOTER */

footer {
    background: #111;
    color: #999;
    text-align: center;
    padding: 20px;
    font-size: 13px;
}

/* MOBILE */

@media (max-width: 600px) {

    .header h1 {
        font-size: 27px;
    }

    .details,
    .amenities {
        grid-template-columns: 1fr;
    }

    .card {
        padding: 20px;
    }

    .price h2 {
        font-size: 27px;
    }
}
</style>
</head>

<body>

<!-- HEADER -->

<div class="header">

    <h1>🏠 1 BHK HOUSE FOR RENT</h1>

    <p>Beautiful & Comfortable Home Available</p>

</div>


<div class="container">


<!-- FIRST HOUSE IMAGE -->

<img src="house1.jpg"
     alt="House"
     class="property-image">


<!-- ABOUT -->

<div class="card">

    <h2>🏡 About the Property</h2>

    <p>
        A beautiful and well-maintained 1 BHK house
        is available for rent.

        Perfect for a small family, couple or working
        professional.
    </p>

</div>


<!-- PRICE -->

<div class="price">

    <p>Monthly Rent</p>

    <h2>₹8,000 / Month</h2>

    <p>Security Deposit: ₹25,000</p>

</div>


<!-- SECOND IMAGE -->

<img src="house2.jpg"
     alt="House Interior"
     class="property-image">


<!-- PROPERTY DETAILS -->

<div class="card">

    <h2>📋 Property Details</h2>

    <div class="details">

        <div class="detail">
            <strong>🛏️ Type</strong>
            1 BHK
        </div>

        <div class="detail">
            <strong>📐 Area</strong>
            650 sq.ft.
        </div>

        <div class="detail">
            <strong>🚿 Bathroom</strong>
            1 Bathroom
        </div>

        <div class="detail">
            <strong>🍳 Kitchen</strong>
            1 Kitchen
        </div>

        <div class="detail">
            <strong>🚗 Parking</strong>
            Available
        </div>

        <div class="detail">
            <strong>🏢 Floor</strong>
            Ground Floor
        </div>

    </div>

</div>


<!-- THIRD IMAGE -->

<img src="house3.jpg"
     alt="House"
     class="property-image">


<!-- AMENITIES -->

<div class="card">

    <h2>✨ Amenities</h2>

    <div class="amenities">

        <div class="amenity">💧 24×7 Water Supply</div>
        <div class="amenity">⚡ Electricity</div>
        <div class="amenity">🚗 Parking</div>
        <div class="amenity">🔒 Safe Area</div>
        <div class="amenity">🌬️ Good Ventilation</div>
        <div class="amenity">📍 Good Location</div>

    </div>

</div>


<!-- LOCATION -->

<div class="card">

    <h2>📍 Location</h2>

    <p>
        Your Location Name<br>
        Near Main Road<br>
        Your City, Bihar
    </p>

</div>


<!-- FOURTH IMAGE -->

<img src="house4.jpg"
     alt="House"
     class="property-image">


</div>


<!-- CONTACT -->

<div class="contact">

    <h2>📞 Interested?</h2>

    <p>Contact us for more information or to visit the property.</p>

    <p class="phone">
        📱 +91 9934869909
    </p>

    <a
        class="whatsapp"
        href="https://wa.me/919934869909"
        target="_blank">

        💬 Contact on WhatsApp

    </a>

</div>


<footer>

    © 2026 Property Listing

</footer>

</body>
</html>
